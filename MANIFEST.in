include README.md LICENSE AGENTS.md CITATION.cff PROVENANCE.md DATA_AVAILABILITY.md CHANGELOG.md uv.lock
include .gitignore .gitattributes
recursive-include tests *.py LICENSE
recursive-include .github *.py *.yml
recursive-include docs *.md
recursive-include scripts *.py
recursive-include examples *.py *.json *.jsonl *.jpg *.png *.md *.sha256
global-exclude *.pyc
global-exclude __pycache__
